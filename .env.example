# ─────────────────────────────────────────────────────────────
# Aria Console — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values from your
# Supabase project (Dashboard → Project Settings → API).
# NEVER commit your real `.env` file.

# ── Supabase (the only database — Postgres + Auth + REST) ─────
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Publishable key (new API key format — safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxx"

# Secret key (new API key format — server only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxx"

# Optional: JWKS endpoint for external JWT verification
# SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# Legacy JWT keys (anon / service_role) also work:
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Aria Console"
NEXT_PUBLIC_APP_VERSION="4.2.1"
