# ╔═══════════════════════════════════════════════════════════════════╗
# ║  Aria Console — Vercel Environment Variables (template)            ║
# ║  Copy each value below into Vercel Project Settings → Environment  ║
# ║  Variables. Set them for Production, Preview, AND Development.     ║
# ║  NEVER commit real keys — this file must contain placeholders only.║
# ╚═══════════════════════════════════════════════════════════════════╝

# ── Supabase (the only database — Postgres + Auth + REST) ───────────
# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (Settings → API — replaces the old anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Secret key (Settings → API — replaces the old service_role key; server-only)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Aria Console"
NEXT_PUBLIC_APP_VERSION="4.2.1"
